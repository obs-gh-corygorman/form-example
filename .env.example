# OpenTelemetry Configuration
# Server-side OTLP endpoint (used by Node.js server)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Server-side OTLP bearer token (optional)
OTEL_EXPORTER_OTLP_BEARER_TOKEN=

# Client-side OTLP endpoint (used by browser)
# Note: Must be publicly accessible from the browser
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Client-side OTLP bearer token (optional)
# Note: This will be exposed to the browser, use with caution
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_BEARER_TOKEN=
