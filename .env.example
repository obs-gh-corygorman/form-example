# OpenTelemetry Configuration
# Server-side OTLP endpoint (optional, defaults to http://localhost:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_BEARER_TOKEN=your-auth-token-here

# Client-side OTLP endpoint (optional, defaults to http://localhost:4318)
# Note: These must be prefixed with NEXT_PUBLIC_ for Next.js client-side access
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_BEARER_TOKEN=your-auth-token-here

# Example production configuration
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-collector.example.com:4318
# NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-collector.example.com:4318
