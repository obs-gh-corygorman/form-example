# OpenTelemetry Configuration
# Copy this file to .env.local and configure your values

# OTLP Endpoint for sending traces (required)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Bearer token for OTLP endpoint authentication (required)
OTEL_EXPORTER_OTLP_BEARER_TOKEN=your_bearer_token_here

# Service configuration (optional)
OTEL_SERVICE_NAME=nextjs-form-example
OTEL_SERVICE_VERSION=1.0.0
OTEL_SERVICE_NAMESPACE=production

# Node environment (automatically set by Next.js)
# NODE_ENV=development