# OpenTelemetry Configuration
# Server-side variables (these should be set by the environment)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-observe-endpoint.com
# OTEL_EXPORTER_OTLP_BEARER_TOKEN=your-bearer-token-here

# Client-side variables (copy from server-side for browser telemetry)
# Uncomment and set these to enable client-side telemetry
# NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT}
# NEXT_PUBLIC_OTEL_EXPORTER_OTLP_BEARER_TOKEN=${OTEL_EXPORTER_OTLP_BEARER_TOKEN}
